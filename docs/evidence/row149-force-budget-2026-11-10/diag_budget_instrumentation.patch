+subroutine diagBtS(globalShapeFunc, stress, constk, fout)
+    ! row 149 diagnostic: the B^T*sigma nodal force of calcElemKU, stress part only
+    use globalvar
+    implicit none
+    integer (kind = 4) :: i, j1, j2, j3
+    real (kind = dp) :: globalShapeFunc(nrowsh-1,nen), stress(6), constk, fout(nee), bb(nrowb,nee), st(6)
+    call calcB(globalShapeFunc,bb)
+    st = constk*w*stress
+    do i=1,nen
+        j1 = ned * (i - 1) + 1
+        j2 = ned * (i - 1) + 2
+        j3 = ned * (i - 1) + 3
+        fout(j1) = bb(1,j1)*st(1) + bb(5,j1)*st(5) + bb(6,j1)*st(6)
+        fout(j2) = bb(2,j2)*st(2) + bb(4,j2)*st(4) + bb(6,j2)*st(6)
+        fout(j3) = bb(3,j3)*st(3) + bb(4,j3)*st(4) + bb(5,j3)*st(5)
+    enddo
+end subroutine diagBtS
