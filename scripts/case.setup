#! /usr/bin/env python3
"""
Script to setup the case via user_defined_params.py.
"""
import sys

# Compset files that a case_input directory SHARES with another compset
# (board item 44): test.tpv37's copy is a symlink to test.tpv36's. If the
# case directory lacks one, say which file and why, not a bare traceback.
SHARED_COMPSET_FILES = {
    'tpv36_37_common': 'case_input/test.tpv36/tpv36_37_common.py '
                       '(case_input/test.tpv37/tpv36_37_common.py is a symlink to it)',
}
try:
    from user_defined_params import par
except ModuleNotFoundError as e:
    if e.name in SHARED_COMPSET_FILES:
        sys.exit('case.setup: user_defined_params.py imports %s, but %s.py is not '
                 'in this case directory. It is the shared compset file %s; '
                 'rebuild the case with create.newcase from a checkout where '
                 'that file exists.' % (e.name, e.name, SHARED_COMPSET_FILES[e.name]))
    raise
from lib import (ensureFaultRoughGeometryForCase, resolveNormalStressSign, resolveViscoplasticParams,
                 faultTag, resolveFaultGeom, resolveOnFaultStationsPerFault, resolveOnFaultVarsPerFault)
from machines import machine, write_slurm_header
import netCDF4 as nc
import numpy as np
import os

def create_model_input_file():
    # Function to create bGlobal.txt, bModelGeometry.txt, b.FaultGeometry.txt,
    #  bMaterial.txt, bStations.txt used by EQdyna.
    with open('bGlobal.txt', 'w') as f:
        f.write(str(par.mode)        + "\n")
        f.write(str(par.C_elastic)   + "\n")
        f.write(str(par.C_nuclea)    + "\n")
        f.write(str(par.C_degen)     + "\n")
        f.write(str(par.insertFaultType) + "\n")
        f.write(str(par.friclaw)  + "\n")
        f.write(str(par.ntotft)   + "\n")
        f.write(str(par.nucfault) + "\n")
        f.write(str(par.tpv)      + "\n")
        f.write(str(par.output_plastic) + "\n")
        f.write(str(par.outputGroundMotion) + "\n")
        f.write(str(par.outputFinalSurfDisp) + "\n")
        f.write(" "           + "\n")
        f.write(str(par.nx) + " " + str(par.ny) + " " + str(par.nz) + "\n")
        f.write(" "     + "\n")
        f.write(str(par.term) + "\n")
        f.write(str(par.dt)   + "\n")
        f.write(" "       + "\n")
        f.write(str(par.nmat)  + " " + str(par.n2mat) + "\n")
        f.write(str(par.roumax)+" "+str(par.rhow)+" "+str(par.gamar)+"\n")
        f.write(str(par.rdampk)+" "+str(par.vmaxPML)+"\n")
        f.write(" "     + "\n")
        f.write(str(par.xsource) + " " + str(par.ysource) + " " + str(par.zsource) + "\n")
        f.write(str(par.nucR) + " " + str(par.nucRuptVel) + " " + str(par.nucdtau0) + " " + str(par.nucT) + "\n")
        f.write(str(par.str1ToFaultAngle) + " " + str(par.devStrToStrVertRatio) + "\n")
        f.write(str(par.bulk)+" "+str(par.coheplas)+"\n")
        f.write(str(par.strike) + " " + str(par.dip) + "\n")
        f.write(str(par.slipRateThres) + "\n")
        # Viscoplastic / plastic-output block (readInputFiles.f90's readglobal
        # reads it unconditionally and refuses a file that lacks it, rather
        # than falling back to the constants the solver used to compile in).
        # Written for every case, elastic ones included, so bGlobal.txt has
        # ONE format -- the same reason bulk/coheplas are written above
        # regardless of C_elastic.
        tv, taperStart, taperEnd, plasticWindow = resolveViscoplasticParams(par)
        f.write(" " + "\n")
        f.write(str(tv) + "\n")
        f.write(str(taperStart) + " " + str(taperEnd) + "\n")
        f.write(str(plasticWindow[0]) + " " + str(plasticWindow[1]) + " " + str(plasticWindow[2]) + "\n")
        # Station n-stress sign convention (board row 22a): the LAST line,
        # read unconditionally by readglobal and read_bglobal, which refuse a
        # file without it as stale.
        f.write(str(resolveNormalStressSign(par)) + "\n")


    with open('bModelGeometry.txt', "w") as f:
        f.write(str(par.xmin) + "  " + str(par.xmax) + "\n")
        f.write(str(par.ymin) + "  " + str(par.ymax) + "\n")
        f.write(str(par.zmin) + "  " + str(par.zmax) + "\n")
        f.write(" " + "\n")
        f.write(str(par.nuni_y_minus) + " " + str(par.nuni_y_plus) + "\n")
        f.write(str(par.enlarging_ratio) + "\n")
        f.write(str(par.dx) + " " + str(par.dy) + " " + str(par.dz) + "\n")
        
    with open('bFaultGeometry.txt', "w") as f:
        # Row 17 (multi-fault): one box per fault (par.faultgeom, the
        # eqquasi-style list-of-boxes pattern), not the same box repeated --
        # see resolveFaultGeom for the ntotft==1 backward-compat fallback.
        faultgeom = resolveFaultGeom(par)
        for i in range(par.ntotft):
            fxmin_i, fxmax_i, fymin_i, fymax_i, fzmin_i, fzmax_i = faultgeom[i]
            f.write("For fault No. " + str(i+1) + "\n")
            f.write(str(fxmin_i) + "  " + str(fxmax_i) + "\n")
            f.write(str(fymin_i) + "  " + str(fymax_i) + "\n")
            f.write(str(fzmin_i) + "  " + str(fzmax_i) + "\n")
            
    with open('bMaterial.txt', "w") as f:
        if par.nmat == 1:
            f.write(str(par.vp) + " " + str(par.vs) + " " + str(par.rou) + "\n")
        elif par.nmat > 1:
            # n2mat columns per row: 4 for the 1D layered table
            # [bottom, vp, vs, rho], 5 for the two-sided table
            # [bottom, vp, vs, rho, side], 6 for the 3D structured grid
            # [x, y, z, vp, vs, rho] (readInputFiles.f90 readmaterial
            # reads `(material(i,j), j = 1, n2mat)`).
            for i in range(par.nmat):
                f.write(" ".join(str(par.mat[i,j]) for j in range(par.n2mat)) + "\n")

def create_station_input_file():
    # Function to create model.txt used by EQquasi.
    #
    # Row 17 (multi-fault): readInputFiles.f90:152 reads `(nonfs(i), i = 1,
    # ntotft)` -- ntotft integers -- from line 2 of this file, so the writer
    # must emit ntotft counts, one per fault, and the on-fault station block
    # below must be grouped by fault in the SAME order readstations2 reads it
    # back (`do i = 1, ntotft; do j = 1, nonfs(i)`). resolveOnFaultStationsPerFault
    # supplies that per-fault grouping (par.st_coor_on_fault unchanged, and
    # read back as before, at ntotft==1).
    stations_per_fault = resolveOnFaultStationsPerFault(par)
    nonfs = [len(s) for s in stations_per_fault]
    with open('bStations.txt', 'w') as f:
        f.write(str(par.n_off_fault) + "\n")
        f.write(" ".join(str(n) for n in nonfs) + "\n")
        f.write(str(" ") + "\n")
        for i in range(par.ntotft):
            for x, z in stations_per_fault[i]:
                f.write(str(x) + " " + str(z) + "\n")
        f.write(str(" ") + "\n")
        for i in range(len(par.st_coor_off_fault)):
            f.write(str(par.st_coor_off_fault[i][0]) + " " + str(par.st_coor_off_fault[i][1]) + " " + str(par.st_coor_off_fault[i][2]) + "\n")

def netcdf_write_on_fault_vars():
  # Function to write on_fault_vars_input.nc, read back by
  # netcdf_read_on_fault_eqdyna (src/fortran/netcdf_io.f90).
  #
  # Row 17 (multi-fault): one full set of the 24 variables per fault, in the
  # SAME file, named with faultTag() -- '' for fault 1, 'ft<N>_' for fault
  # N>=2 -- exactly the convention library_output.f90's Fortran faultTag()
  # uses for station/cplot/src_evol filenames. Fault 1's variable names are
  # UNPREFIXED, so an ntotft==1 case writes byte-identical variable names and
  # values to before -- this is a no-op refactor at ntotft==1 (still one
  # fault, still par.fx/par.fz/par.nfx/par.nfz/par.on_fault_vars).
  #
  # Faults 2+ get their own (dip, strike) dimensions sized to THEIR OWN box
  # (from resolveFaultGeom), not fault 1's -- two parallel faults need not be
  # the same length. resolveOnFaultVarsPerFault refuses (rather than
  # silently reusing fault 1's array) when ntotft>1 and no per-fault array is
  # given -- eqquasi's own documented failure mode.
  faultgeom = resolveFaultGeom(par)
  on_fault_vars_list = resolveOnFaultVarsPerFault(par)
  ds = nc.Dataset("on_fault_vars_input.nc", "w", format="NETCDF4")

  for ift in range(1, par.ntotft + 1):
    i = ift - 1
    tag = faultTag(ift, par.ntotft)
    on_fault_vars = on_fault_vars_list[i]
    if i == 0:
      # Bit-identical to the pre-multi-fault writer: par.fx/par.fz/par.nfx/
      # par.nfz are exactly what fault 1's box would recompute to, but reuse
      # them directly rather than re-deriving, to avoid any floating-point
      # drift in a linspace re-evaluation.
      nfx_i, nfz_i, fx_i, fz_i = par.nfx, par.nfz, par.fx, par.fz
    else:
      fxmin_i, fxmax_i, fymin_i, fymax_i, fzmin_i, fzmax_i = faultgeom[i]
      nfx_i = round((fxmax_i - fxmin_i) / par.dx + 1)
      nfz_i = round((fzmax_i - fzmin_i) / par.dz + 1)
      fx_i  = np.linspace(fxmin_i, fxmax_i, nfx_i)
      fz_i  = np.linspace(fzmin_i, fzmax_i, nfz_i)

    dip        = ds.createDimension(tag + 'dip', nfz_i)
    strike     = ds.createDimension(tag + 'strike', nfx_i)
    dip_var    = ds.createVariable(tag + 'dip', np.float64, (tag + 'dip',))
    strike_var = ds.createVariable(tag + 'strike', np.float64, (tag + 'strike',))

    dims = (tag + 'dip', tag + 'strike')
    # for the slip weakening law
    var0  = ds.createVariable(tag + 'sw_fs', np.float64, dims)
    var1  = ds.createVariable(tag + 'sw_fd', np.float64, dims)
    var2  = ds.createVariable(tag + 'sw_D0', np.float64, dims)

    # for the rsf
    var3  = ds.createVariable(tag + 'rsf_a',  np.float64, dims)
    var4  = ds.createVariable(tag + 'rsf_b',  np.float64, dims)
    var5  = ds.createVariable(tag + 'rsf_Dc', np.float64, dims)
    var6  = ds.createVariable(tag + 'rsf_v0', np.float64, dims)
    var7  = ds.createVariable(tag + 'rsf_r0', np.float64, dims)

    # additional for the rsf slip law with strong rate weakening
    var8  = ds.createVariable(tag + 'rsf_fw',  np.float64, dims)
    var9  = ds.createVariable(tag + 'rsf_vw',  np.float64, dims)

    # additional for the rsf with thermal pressurization
    var10 = ds.createVariable(tag + 'tp_a_hy',  np.float64, dims)
    var11 = ds.createVariable(tag + 'tp_a_th',  np.float64, dims)
    var12 = ds.createVariable(tag + 'tp_rouc',  np.float64, dims)
    var13 = ds.createVariable(tag + 'tp_lambda',np.float64, dims)
    var14 = ds.createVariable(tag + 'tp_h',     np.float64, dims)
    var15 = ds.createVariable(tag + 'tp_Tini',  np.float64, dims)
    var16 = ds.createVariable(tag + 'tp_pini',  np.float64, dims)

    # kinematics and initial stresses
    var17 = ds.createVariable(tag + 'init_slip_rate',     np.float64, dims)
    var18 = ds.createVariable(tag + 'init_strike_shear',  np.float64, dims)
    var19 = ds.createVariable(tag + 'init_normal_stress', np.float64, dims)
    var20 = ds.createVariable(tag + 'init_state',         np.float64, dims)
    # for the time weakening law
    var21 = ds.createVariable(tag + 'tw_t0',              np.float64, dims)
    # newly added
    var22 = ds.createVariable(tag + 'cohesion',           np.float64, dims)
    var23 = ds.createVariable(tag + 'init_dip_shear',     np.float64, dims)

    var0.units = 'unit'
    var1.units = 'unit'
    var2.units = 'unit'

    var3.units = "unit"
    var4.units = "unit"
    var5.units = 'meters'
    var6.units = 'm/s'
    var7.units = 'unit'

    var8.units = 'unit'
    var9.units = 'unit'

    var10.units = 'm^2/s'
    var11.units = 'm^2/s'
    var12.units = 'J/(m^3K)'
    var13.units = 'PaK-1'
    var14.units = 'm'
    var15.units = 'K'
    var16.units = 'Pa'

    var17.units = 'm/s'
    var18.units = 'Pa'
    var19.units = 'Pa'
    var20.units = 'unit'

    var21.units = 's'

    var22.units = 'Pa'
    var23.units = 'Pa'

    strike_var[:] = fx_i[:]
    dip_var[:]    = fz_i[:]

    var0[:,:] = on_fault_vars[:,:,1]   # sw_fs
    var1[:,:] = on_fault_vars[:,:,2]   # sw_fd
    var2[:,:] = on_fault_vars[:,:,3]   # sw_D0

    var3[:,:] = on_fault_vars[:,:,9]   # rsf_a
    var4[:,:] = on_fault_vars[:,:,10]  # rsf_b
    var5[:,:] = on_fault_vars[:,:,11]  # rsf_Dc
    var6[:,:] = on_fault_vars[:,:,12]  # rsf_v0
    var7[:,:] = on_fault_vars[:,:,13]  # rsf_r0

    var8[:,:] = on_fault_vars[:,:,14]  # rsf_fw
    var9[:,:] = on_fault_vars[:,:,15]  # rsf_vw

    var10[:,:] = on_fault_vars[:,:,16] # tp_a_hy
    var11[:,:] = on_fault_vars[:,:,17] # tp_a_th
    var12[:,:] = on_fault_vars[:,:,18] # tp_rouc
    var13[:,:] = on_fault_vars[:,:,19] # tp_lambda
    var14[:,:] = on_fault_vars[:,:,40] # tp_h
    var15[:,:] = on_fault_vars[:,:,41] # tp_Tini
    var16[:,:] = on_fault_vars[:,:,42] # tp_pini

    var17[:,:] = on_fault_vars[:,:,46] # init_slip_rate
    var18[:,:] = on_fault_vars[:,:,8]  # init_strike_shear
    var19[:,:] = on_fault_vars[:,:,7]  # init_normal_stress
    var20[:,:] = on_fault_vars[:,:,20] # init_state

    var21[:,:] = on_fault_vars[:,:,5]  # tw_t0
    var22[:,:] = on_fault_vars[:,:,4]  # cohesion
    var23[:,:] = on_fault_vars[:,:,49] # init_dip_shear
  ds.close()
  
def _write_slurm_header(f):
    # Common SBATCH header shared by every batch script this module writes
    # (create_LS6batch_script, create_batch_script_cycle_old,
    # create_batch_script_cycle) -- was written out three times, byte for
    # byte, with only the target filename differing. The writer itself now
    # lives in machines.py (the one HPC-machine registry) so
    # testsys/run.py's --submit sweep job can reuse the exact same header
    # instead of a second copy.
    write_slurm_header(f, jobname=par.casename, nnode=par.HPC_nnode,
                        ncpu=par.HPC_ncpu, queue=par.HPC_queue,
                        walltime=par.HPC_time, account=par.HPC_account,
                        email=par.HPC_email)

def create_LS6batch_script():
    # Function to create batch script used by HPC system.
    with open("batch.hpc", "w") as f:
        _write_slurm_header(f)
        # Executable part. The launcher comes from machines.py, the one
        # registry testsys --submit also reads: on ls6 it is Intel `mpirun`,
        # measured 2026-09-29. TACC's `ibrun` takes -n/-o, never -np, so the
        # `ibrun -np N` this used to write was not a valid ibrun call
        # (2026-10-01). The two Python steps are serial and need no launcher.
        launcher = machine('ls6')['mpirun']
        f.write("  python3 clean.py" + "\n")
        f.write("  " + launcher + " -np " + str(par.nx*par.ny*par.nz) + " eqdyna" + "\n")
        f.write("  python3 plotRuptureDynamics" + "\n") # produce figure of rupture dynamics
        #f.write("for i in $(seq " + str(istart) + " " + str(iend) + ");" + "\n")
        #f.write("do" + "\n")
        #f.write("  echo $i > currentcycle.txt" + "\n")
        #f.write("  ibrun eqquasi" + "\n")
        #f.write("  mkdir \"./Q$((i-1))\"" + "\n")
        #f.write("  mv fltst* srfst* tdyna* global* p1* p2* disp.* fault.* cplot* \"./Q$((i-1))\"" + "\n")
        #f.write("  cp \"./Q$((i-1))/\"*.r.nc ./" + "\n")
        #f.write("done" + "\n")
        # End excutable part.

def create_run_sh():
    # Function to create batch script used by HPC system.
    with open("run.sh", "w") as f:
        f.write("#! /bin/bash" + "\n")
        # Executable part.
        f.write("  python3 clean.py" + "\n")
        f.write("  mpirun -np " + str(par.nx*par.ny*par.nz) + " eqdyna" + "\n")
        f.write("  python3 plotRuptureDynamics" + "\n") # produce figure of rupture dynamics      
        
def create_batch_script_cycle_old():
    # Function to create batch script used by HPC system.
    # made obsolete on 20230228 but kept.
    with open("batch.cycle.hpc", "w") as f:
        _write_slurm_header(f)
        # Executable part.
        f.write("  read i < currentcycle.txt" + "\n")
        f.write("  cp \"../Q$((i-1))/\"*.r.nc ./" + "\n")
        f.write("  ibrun eqdyna" + "\n")
        f.write("  ibrun -np 1 python plotRuptureDynamics" + "\n")
        f.write("  rm -rf \"../D$((i-1))\"" + "\n")
        f.write("  mkdir \"../D$((i-1))\"" + "\n")
        f.write("  mv a.eqdyna.log* body* faultst* frt.txt* global* gm* p2* cRuptureDynamics.png \"../D$((i-1))\"" + "\n")
        # leave the update of currentcycle.txt to ESCI scripts? 
        #f.write("  i=$((i+1))" + "\n")
        #f.write("  echo $i > currentcycle.txt" + "\n")
        # End excutable part.

def create_batch_script_cycle():
    # Function to create batch script used by HPC system.
    with open("batch.cycle.eqdyna.hpc", "w") as f:
        _write_slurm_header(f)
        # Executable part.
        f.write("  read i < currentcycle.txt"       + "\n")
        f.write("# fetch input files from /eqdyna"  + "\n")
        f.write("  cp eqdyna/bFaultGeometry.txt ./" + "\n")
        f.write("  cp eqdyna/bGlobal.txt ./"        + "\n")
        f.write("  cp eqdyna/bMaterial.txt ./"      + "\n")
        f.write("  cp eqdyna/bModelGeometry.txt ./" + "\n")
        f.write("  cp eqdyna/bStations.txt ./"      + "\n")
        f.write("  cp eqdyna/on_fault_vars_input.nc ./" + "\n")
        f.write("  cp eqdyna/rough_geo_cycle.txt ./" + "\n")
        f.write("# fetch fault.r.nc from Q(i-1)"        + "\n")
        f.write("  cp \"Q$((i-1))/\"fault.r.nc ./"  + "\n") 
        f.write("# run eqdyna"                      + "\n")
        f.write("  ibrun eqdyna"                    + "\n")
        f.write("# move results to D(i-1)"          + "\n")
        f.write("# delete D(i-1)"                   + "\n")
        f.write("  rm -rf \"D$((i-1))\""            + "\n")
        f.write("# create D(i-1) and copy results and inputs over" + "\n")
        f.write("  mkdir \"D$((i-1))\""             + "\n")
        f.write("  cp -r a.eqdyna.log* *.r.nc \"D$((i-1))\""   + "\n")
        f.write("  cp -r on_fault_vars_input.nc \"D$((i-1))\"" + "\n")
        f.write("  cp -r currentcycle.txt \"D$((i-1))\""       + "\n")
        f.write("  cp -r body* faultst* frt.txt* global* gm* p2* \"D$((i-1))\""+ "\n")
        f.write("  cp -r currentcycle.txt \"D$((i-1))\""               + "\n")
        f.write("  cp -r eqdyna/plotRuptureDynamics \"D$((i-1))\""     + "\n")
        f.write("  cp -r eqdyna/user_defined_params.py \"D$((i-1))\""  + "\n")
        f.write("  cp -r eqdyna/lib.py \"D$((i-1))\""                  + "\n")
        f.write("# clean up the root for running eqquasi"              + "\n")
        f.write("  rm -rf a.eqdyna.log* bFaultGeometry.txt bGlobal.txt"+ "\n")
        f.write("  rm -rf bMaterial.txt bModelGeometry.txt"            + "\n")
        f.write("  rm -rf bStations.txt *.r.nc"                        + "\n")
        f.write("  rm -rf on_fault_vars_input.nc"                      + "\n")
        f.write("  rm -rf body* faultst* frt.txt* global* gm* p2* "    + "\n")
        f.write("# postprocessing"                                     + "\n")
        f.write("  cd \"D$((i-1))\""                                   + "\n")
        f.write("  ibrun -np 1 python plotRuptureDynamics"             + "\n")
        f.write("  cd .."                                              + "\n")
        f.write("# update cycle id i"                                  + "\n")
        f.write("  i=$((i+1))"                                         + "\n")
        f.write("  echo $i > currentcycle.txt"                         + "\n")
        # End excutable part.
        
def estimate_HPC_resource():
    nx = int((par.xmax-par.xmin)/par.dx)
    nz = int((par.zmax-par.zmin)/par.dx)
    ncell = nx*nz*(par.nuni_y_plus + par.nuni_y_minus)*2
    estimate_ncpu = int(ncell/10000)
    estimate_nnode = int(estimate_ncpu/128) + 1
    print("Estimated total cells in the model is " + str(ncell))
    print("Estimated memory required is about " + str(ncell*1.54/1.e6*par.nx*par.ny*par.nz) +" GBs")
    #print("Estimated number of computing nodes to be requested is " + str(estimate_nnode))
    #print("Estimated number of CPUs to be requested is " + str(estimate_ncpu))

def _main_func(description):
    create_model_input_file()
    create_LS6batch_script()
    create_run_sh()
    create_batch_script_cycle()
    create_station_input_file()
    estimate_HPC_resource()
    netcdf_write_on_fault_vars()
    # Types 1 and 2 are generated here; type 3 means the case supplies its own
    # fault surface, so the generator is not called at all (it would otherwise
    # have to be told to do nothing).
    if par.insertFaultType in (1, 2):
        rc = os.system('./generateFaultInterface')
        if rc != 0:
            raise RuntimeError(
                f'generateFaultInterface failed (exit {rc}); '
                f'bFault_Rough_Geometry.txt was not generated.')
    elif par.insertFaultType == 3:
        print('insertFaultType=3: the case supplies its own fault geometry; '
              'scripts/generateFaultInterface is not called. '
              'bFault_Rough_Geometry.txt is handled below.')
    # Every insertFaultType > 0 reads bFault_Rough_Geometry.txt in the Fortran
    # (eqdyna3d.f90: `if (insertFaultType > 0) call read_fault_rough_geometry`),
    # so every insertFaultType > 0 goes through here -- generated files
    # included, so the generator is held to the same contract as a supplied
    # one. ensureFaultRoughGeometryForCase keeps an already-correct file byte
    # for byte (idempotent re-setup, and no clobbering a deliberately placed
    # surface), regenerates via par.faultGeometryWriter when the compset
    # supplies one, and validates whatever ends up on disk. Raises
    # FaultGeometryError, which stops case.setup (rule 2).
    if par.insertFaultType > 0:
        ensureFaultRoughGeometryForCase(par)
if __name__ == "__main__":
    _main_func(__doc__)
