#!/usr/bin/env python3
"""
1. Plot on fault rupture dynamics.
2. Generate SCECRuptureTime.txt for benchmarking.
"""
import sys
import numpy as np
from math    import *
from user_defined_params import par
from os.path import exists
import matplotlib.pyplot as plt
from matplotlib import animation, rc
import netCDF4 as nc
from lib import loadFrtData, faultTag
#
SMALL_SIZE = 12

def ruptureDynamics():
    """Row 17 (multi-fault): loadFrtData now returns ONE (xx, zz, rupt,
    rupt2d, fVarArr, magnitude, fx, fz, nfx, nfz) tuple PER FAULT -- a list
    of length 1 at ntotft<=1 (every pre-row-17 case). Looping over it and
    tagging every output filename with faultTag(ift, ntotft) ('' for fault
    1/ntotft==1, 'ft<N>_' for fault N>=2) means an ntotft<=1 case still
    writes EXACTLY 'cRuptureDynamics.png'/'SCECRuptureTime.txt' (no suffix,
    byte-identical content -- loadFrtData's own ntotft<=1 branch is the
    unmodified pre-row-17 code path), while an ntotft>1 case gets one panel
    and one restart-variable payload per fault instead of fault #2's rows
    being aliased onto fault #1's grid (or, for a fault whose x-extent
    exceeds fault #1's, indexing clean out of its array -- the crash this
    fix closes, test.tpv22/test.tpv23's own real geometry).

    Returns a list of (fVarArr, fx, fz, nfx, nfz, tag) -- one per fault, fed
    to generateNcRestart in _main_func below.
    """
    faults = loadFrtData(par)
    ntotft = len(faults)
    results = []
    for i, (xx, zz, rupt, rupt2d, fVarArr, magnitude, fx, fz, nfx, nfz) in enumerate(faults, start=1):
        tag = faultTag(i, ntotft)
        suffix = ('_' + tag.rstrip('_')) if tag else ''

        levels = np.linspace(0,30,60)
        #dt     = 30/60
        fig = plt.figure(figsize=(24,12), dpi= 300, facecolor='w', edgecolor='k')

        plt.rc('font', size=SMALL_SIZE)
        ax11 = fig.add_subplot(331)
        plt.contourf(xx,zz,rupt2d[:,:,1])
        plt.colorbar()
        plt.contour(xx,zz,rupt2d[:,:,0], levels)
        plt.title('Slip (m) & Rupture time (per 0.05 s)')

        ax12 = fig.add_subplot(332)
        plt.contourf(xx,zz,rupt2d[:,:,7])
        plt.colorbar()
        plt.title('Slip s (m) ')

        ax13 = fig.add_subplot(333)
        plt.contourf(xx,zz,rupt2d[:,:,8])
        plt.colorbar()
        plt.title('Slip d (m) ')

        ax21 = fig.add_subplot(334)
        plt.contourf(xx,zz,rupt2d[:,:,2])
        plt.colorbar()
        plt.title('Peak slip rate (m/s); Mag = '+str(magnitude))

        ax22 = fig.add_subplot(335)
        plt.contourf(xx,zz,rupt2d[:,:,3])
        plt.colorbar()
        plt.title('Final slip rate (m/s)')

        ax23 = fig.add_subplot(336)
        plt.contourf(xx,zz,rupt2d[:,:,4])
        plt.colorbar()
        plt.title('Shear stress (MPa)')

        ax31 = fig.add_subplot(337)
        plt.contourf(xx,zz,rupt2d[:,:,6])
        plt.colorbar()
        plt.title('Dip shear stress (MPa)')

        ax32 = fig.add_subplot(338)
        plt.contourf(xx,zz,rupt2d[:,:,5])
        plt.colorbar()
        plt.title('Normal stress (MPa)')

        ax11.set_ylabel('Depth, km')
        ax21.set_ylabel('Depth, km')
        ax31.set_ylabel('Depth, km')
        ax31.set_xlabel('Along strike distance, km')
        ax32.set_xlabel('Along strike distance, km')
        #plt.contourf(xx,zz,rupt2d[:,:,9])
        #plt.contourf(xx,zz,rupt2d[:,:,9])
        #plt.colorbar()
        #plt.title('Normal stress change (MPa)')

        np.savetxt('SCECRuptureTime%s.txt' % suffix, rupt, fmt='%e', delimiter='\t',
                    header= "j k t", comments = ' ')

        plt.savefig("cRuptureDynamics%s.png" % suffix, dpi = 300)
        plt.close()

        results.append((fVarArr, fx, fz, nfx, nfz, suffix))

    return results

def finalSurfDisp():
    nprocs = par.nx*par.ny*par.nz
    ntag = 0
    for me in range(nprocs):
        fname = 'surface_coor.txt' + str(me)
        fname2 = 'finalSurfDisp.txt' + str(me)
        if exists(fname):
            ntag = ntag + 1
            print('Post-processing ' + fname + ' ... ...')
            a = np.loadtxt(fname)
            xyCoor = a[:,:2]
            surfDisp = np.loadtxt(fname2)
            h_disp = surfDisp[:,0].reshape(-1,1)
            v_disp = -surfDisp[:,2].reshape(-1,1)
            n_disp = surfDisp[:,1].reshape(-1,1)
            surfCoorDispPerProc = np.concatenate((xyCoor,h_disp,v_disp,n_disp), axis=1)
            if ntag == 1: 
                scec = surfCoorDispPerProc
            else: 
                scec = np.concatenate((scec, surfCoorDispPerProc), axis=0)
    if ntag == 0:
        # Used to fall through to an UnboundLocalError on `scec`. A run with
        # outputFinalSurfDisp=1 that wrote no surface_coor.txt* is a missing
        # output, and says so (rule 2).
        raise SystemExit('plotRuptureDynamics: par.outputFinalSurfDisp=1 but no '
                         'surface_coor.txt<rank> file exists for any of %d rank(s). '
                         'The Python port does not write it (output_finalSurfDisp '
                         'is not ported, docs/fortran_python_correspondence.md); '
                         'pass --skip-final-surf-disp to build only the nc.' % nprocs)

    _, unique_indices = np.unique(scec[:, :2], axis=0, return_index=True)
    scec = scec[unique_indices]
    
    np.savetxt('SCECFinalSurfDisp.txt', scec, fmt='%e', delimiter='\t',
                header= "x y h_disp v_disp n_disp", comments = ' ')
    
    fig, axs = plt.subplots(1, 3, figsize=(15, 5))

    sc0 = axs[0].scatter(scec[:, 0], scec[:, 1], c=scec[:, 2], cmap='coolwarm_r')
    fig.colorbar(sc0, ax=axs[0], label='h_disp')
    axs[0].set_title('h_disp (m)')
    axs[0].set_xlabel('x (m)')
    axs[0].set_ylabel('y (m)')

    sc1 = axs[1].scatter(scec[:, 0], scec[:, 1], c=scec[:, 3], cmap='coolwarm_r')
    fig.colorbar(sc1, ax=axs[1], label='v_disp')
    axs[1].set_title('v_disp (m)')
    axs[1].set_xlabel('x (m)')
    axs[1].set_ylabel('y (m)')

    sc2 = axs[2].scatter(scec[:, 0], scec[:, 1], c=scec[:, 4], cmap='coolwarm_r')
    fig.colorbar(sc2, ax=axs[2], label='n_disp')
    axs[2].set_title('n_disp (m)')
    axs[2].set_xlabel('x (m)')
    axs[2].set_ylabel('y (m)')

    plt.tight_layout()
    plt.savefig("cFinalSurfDisp.png", dpi=300)
    plt.close()

RESTART_VARS = [('shear_strike', 'Pa'), ('shear_dip', 'Pa'), ('effective_normal', 'Pa'),
                ('slip_rate', 'm/s'), ('state_variable', 'unit'), ('state_normal', 'Pa'),
                ('vxm', 'm/s'), ('vym', 'm/s'), ('vzm', 'm/s'),
                ('vxs', 'm/s'), ('vys', 'm/s'), ('vzs', 'm/s')]

def generateNcRestart(faults):
    # Write fault.dyna.r.nc, the restart file EQquasi's
    # netcdf_read_on_fault_restart(infile1, infile2) reads as infile2: the 12
    # RESTART_VARS, gridded from frt.txt* by loadFrtData. infile1 (a, b, Dc,
    # v0, r0) is provided by EQquasi.
    #
    # faults is ruptureDynamics' list of (fVarArr, fx, fz, nfx, nfz, suffix),
    # one per fault, each on that fault's own strike/dip grid. One fault keeps
    # the 2-D (dip, strike) layout. More than one uses EQquasi's own
    # netcdf_write_on_fault layout, the same one EQdyna reads fault.r.nc in:
    # one file, untagged variables, dims (nid_fault, dip, strike), each fault
    # at the (0, 0) corner of its own slice, zero-padded to the largest
    # fault's extent.

    ds = nc.Dataset("fault.dyna.r.nc", "w", format="NETCDF4")

    if len(faults) == 1:
        faultVarArr, fx, fz, nfx, nfz, _ = faults[0]
        dip        = ds.createDimension('dip',    nfz)
        strike     = ds.createDimension('strike', nfx)
        dip_var    = ds.createVariable('dip', np.float64, ('dip',))
        strike_var = ds.createVariable('strike', np.float64, ('strike',))
        dims       = ('dip', 'strike',)
    else:
        nfxMax     = max(f[3] for f in faults)
        nfzMax     = max(f[4] for f in faults)
        ds.createDimension('nid_fault', len(faults))
        ds.createDimension('dip',       nfzMax)
        ds.createDimension('strike',    nfxMax)
        flt_var    = ds.createVariable('nid_fault', np.int32, ('nid_fault',))
        dims       = ('nid_fault', 'dip', 'strike',)

    var = [ds.createVariable(name, np.float64, dims) for name, _ in RESTART_VARS]
    for v, (_, unit) in zip(var, RESTART_VARS):
        v.units = unit

    if len(faults) == 1:
        strike_var[:] = fx[:]
        dip_var[:]    = fz[:]
        for k, v in enumerate(var):
            v[:,:] = faultVarArr[:,:,k]
    else:
        flt_var[:] = np.arange(1, len(faults) + 1)
        for k, v in enumerate(var):
            arr = np.zeros((len(faults), nfzMax, nfxMax))
            for ift, (faultVarArr, fx, fz, nfx, nfz, _) in enumerate(faults):
                arr[ift, :nfz, :nfx] = faultVarArr[:nfz, :nfx, k]
            v[:,:,:] = arr

    ds.close()
  
def _main_func(description):
    results = ruptureDynamics()
    print('Generating rupture dynamics figure ...')
    generateNcRestart(results)
    print('Generating restart file fault.dyna.r.nc ...')

    if par.outputFinalSurfDisp==1:
        if '--skip-final-surf-disp' in sys.argv[1:]:
            print('plotRuptureDynamics: --skip-final-surf-disp -- final surface '
                  'displacement NOT post-processed (outputFinalSurfDisp=1)')
        else:
            finalSurfDisp()

if __name__ == "__main__":
    _main_func(__doc__)
